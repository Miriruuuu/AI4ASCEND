# ===========================================================================
# 四子棋联机后端配置示例
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不要提交到仓库）
# 下面的 Mongo 值就是宝塔服务器上的实际账号，用户名 / 密码 / 认证库请按你
# 宝塔面板里「数据库」页面显示的实际账号修改。
# ===========================================================================

# HTTP / WebSocket 监听端口（宝塔记得在安全组 + 防火墙放行）
PORT=8787

# MongoDB 主机端口（不带账号密码；账号由 MONGODB_USER / MONGODB_PASSWORD 拼接）
MONGODB_URI=mongodb://190.92.233.254:27017

# MongoDB 账号：与数据库同名（宝塔建库时通常就是同名账号）
# 密码含 @ : / ? # 等特殊字符也不用改写，服务端会自动做 URL 编码
MONGODB_USER=miriru
MONGODB_PASSWORD=lin162636

# MongoDB 认证库：宝塔上用户默认建在 admin 库并按 admin 鉴权，因此保持 admin
MONGODB_AUTH_SOURCE=admin

# 数据库名（回放集合 replays 位于该库）
DB_NAME=miriru

# 存储模式：mongo = 连 Mongo（连不上重试 3 次后退出）；memory = 纯内存（重启丢数据，仅调试用）
DB_MODE=mongo

# 是否由本服务同时托管前端构建产物（true 时一个 Node 进程 = 前端 + 后端 + WebSocket）
SERVE_FRONTEND=true

# 前端产物目录：相对 back/ 目录解析；../dist 即仓库根目录的 vite 构建产物
FRONTEND_DIR=../dist

# 允许的跨域来源：* 表示不限制；多个用英文逗号分隔，例如 https://game.example.com,http://localhost:5173
CORS_ORIGINS=*

# 对局（及已结束对局）在内存中的保留时长，毫秒
MATCH_TTL_MS=1800000

# 匹配码房间有效期，毫秒（默认 10 分钟）
ROOM_TTL_MS=600000

# 日志级别：debug | info | warn | error | silent
LOG_LEVEL=info
